{
  "manifest_version": 3,
  "name": "Vimeo Transcript Copier",
  "version": "0.1.0",
  "description": "Copy/download transcripts from Vimeo players (e.g. KodeKloud).",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://player.vimeo.com/*",
    "https://captions.vimeo.com/*"
  ]
}
